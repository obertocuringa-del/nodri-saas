{
  "manifest_version": 3,
  "name": "NODRI — Feedback Avec",
  "version": "1.0.0",
  "description": "Lê o relatório de agendamentos do Avec de tempos em tempos e entrega ao NODRI quem pagou hoje, para o pedido de feedback sair sozinho pelo CRM.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://admin.avec.beauty/*",
    "https://www.nodri.com.br/*",
    "https://nodri.com.br/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://admin.avec.beauty/*"],
      "js": ["avec.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "opcoes.html",
  "action": { "default_title": "NODRI — Feedback Avec (abrir opções)" }
}
